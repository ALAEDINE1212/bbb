{
  "hosting": {
    "site": "my-baby-35bb9",
    "public": ".",
    "ignore": [
      "firebase*.json",
      "**/.*",
      "**/node_modules/**",
      "app/**",
      "graphify-out/**",
      "CLAUDE.md",
      "README.md"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.png",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
